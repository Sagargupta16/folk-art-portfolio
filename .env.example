# Copy to .env.local (gitignored) and fill in real values. Never commit secrets.
# What each value is and where it comes from: docs/DEVELOPMENT.md (setup),
# docs/DATABASE.md (DATABASE_URL), docs/IMAGES.md (R2_*), docs/AUTH.md (AUTH_*).
#
# The same values are set as Vercel env vars (prod + preview) and as GitHub
# Actions secrets, since the catalog seam reads Neon + R2 at build time.

# --- Auth.js v5 (Google sign-in) ---
# Generate AUTH_SECRET with `npx auth secret`. Google ID/secret from the
# Google Cloud OAuth client. The admin allowlist is NOT here -- it lives in the
# `maintainers` DB table. The first root is provisioned during admin setup
# (docs/AUTH.md), never by the catalog seed, and the roster is editable from
# the /admin panel.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Neon (Postgres) database ---
# Pooled connection string from the Neon dashboard (matches the ledger-sync setup).
DATABASE_URL=

# --- Cloudflare R2 (image storage) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=kalchar-artworks
R2_PUBLIC_BASE_URL=
# Client-readable copy of the R2 public base (the gallery is a client
# component, so it reads NEXT_PUBLIC_*). Same value as R2_PUBLIC_BASE_URL.
NEXT_PUBLIC_IMAGE_BASE_URL=

# --- Local verification only (never set on Vercel) ---
# KALCHAR_TEST_FIXTURES=1 swaps Neon and R2 for read-only fixtures so CI can
# build and run browser checks without production credentials. lib/env.ts
# refuses it when VERCEL=1, so it cannot reach a deployment.
# KALCHAR_TEST_FIXTURES=
# Disposable local PostgreSQL for `pnpm db:check`. The script accepts only a
# local host and the database name kalchar_migration_test.
# MIGRATION_TEST_DATABASE_URL=postgresql://postgres@localhost:5432/kalchar_migration_test
